# Copy to .env and fill in real values. Never commit .env.

# Native PostgreSQL 16 (ADR-0010)
DATABASE_URL="postgresql://bnv:CHANGE_ME@localhost:5432/bnv_db?schema=public"

# First super_admin, created by `npm run db:seed` (password: 12+ characters)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js secret (sprint 1H). Generate with: npx auth secret
AUTH_SECRET=

# Cloudinary signed uploads (ADR-0021). The API secret stays server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
