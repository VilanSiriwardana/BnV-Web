  "narrative": {
    "northStar": "Cinematic Lavender Luxury",
    "overview": "A fashion-editorial storefront that feels like a soft mood board brought to life: warm ivory light, lavender identity moments, blush sections and rare champagne-gold details. Premium comes from restraint: few colours, generous space, engraved Cinzel capitals for headings, literary Cormorant Garamond for copy, quiet Inter for everything functional, and gentle motion that reveals rather than performs.",
    "keyCharacteristics": [
      "Warm ivory base with lavender, blush and gold as rationed accents.",
      "Cinzel headings, Cormorant Garamond copy, Inter for UI.",
      "Medium-radius soft shapes; never pills, never sharp.",
      "Quiet, warm-tinted shadows; depth stays soft.",
      "Slow, eased reveals; nothing bounces."
    ],
    "rules": [
      {
        "name": "The Rationed Gold Rule",
        "body": "Champagne Gold appears in at most one action or tag cluster per screen. Its rarity is what makes it premium.",
        "section": "colors"
      },
      {
        "name": "The Charcoal-On-Colour Rule",
        "body": "Text on lavender, rose or gold fills is always Soft Charcoal; lavender or gold text on light surfaces uses the -text tokens.",
        "section": "colors"
      },
      {
        "name": "The Semantic Token Rule",
        "body": "Use semantic tokens (bg-primary, text-gold-text), never literal hex or Tailwind palette colours.",
        "section": "colors"
      },
      {
        "name": "The Story-and-Interface Rule",
        "body": "Cinzel and Cormorant Garamond tell the story; Inter runs the interface (buttons, inputs, badges, navigation, prices, admin).",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Elevation rises one step on hover, never more, and never on static content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic tokens from app/globals.css and the constants in src/config/motion.ts.",
      "Do keep text on lavender, rose and gold fills Soft Charcoal, and use primary-text / gold-text for coloured text.",
      "Do reuse Reveal, Stagger and the src/components/ui primitives before writing new ones.",
      "Do design every screen for mobile first and check both light and dark themes.",
      "Do respect prefers-reduced-motion: remove movement, keep short fades."
    ],
    "donts": [
      "Don't use pill buttons, bouncy springs, excessive parallax or many simultaneous animations.",
      "Don't scale on hover beyond 1.03.",
      "Don't spend gold on more than one cluster per screen.",
      "Don't use heavy filled or cartoon icons.",
      "Don't make it look like Amazon, Daraz, a Shopify template, a wedding invitation or a Valentine promotion."
