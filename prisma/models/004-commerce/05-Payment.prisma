model Payment {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  provider             String
  method               String?
  paymentReference     String?   @map("payment_reference")
  gatewayTransactionId String?   @map("gateway_transaction_id")
  currencyCode         String    @default("LKR") @map("currency_code") @db.Char(3)
  amount               Decimal   @db.Decimal(12, 2)
  status               String    @default("pending")
  gatewayPayload       Json?     @map("gateway_payload")
  gatewayResponse      Json?     @map("gateway_response")
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  failedAt             DateTime? @map("failed_at") @db.Timestamptz(6)
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([provider])
  @@index([paymentReference])
  @@index([status])
  @@map("payments")
}
